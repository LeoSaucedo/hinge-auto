# HingeAuto — ⚠️ fill in at least one API key

# Anthropic (JUDGE_BACKEND=anthropic) — best quality
ANTHROPIC_API_KEY=***

# Gemini (JUDGE_BACKEND=gemini) — cheap, good quality
GEMINI_API_KEY=***

# Discord webhook for session reports (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Mode selection (default in config.py)
ACTIVE_MODE=carlos

# Judge settings
JUDGE_BACKEND=gemini
# Gemini flash options: gemini-3.1-flash-lite (cheapest), gemini-3.5-flash,
# gemini-3.8-flash (most intelligent)
GEMINI_MODEL=gemini-3.8-flash

# Session limits
MAX_LIKES_PER_SESSION=12
SESSION_LIKE_MIN=0

# Run mode
DRY_RUN=false
DRY_RUN_MESSAGE=false

# Debug output directory — where error screenshots and liked/skipped
# profile frames land (defaults to ./debug). Relative paths resolve from
# the repo root; absolute paths are used as-is.
DEBUG_DIR=./debug
