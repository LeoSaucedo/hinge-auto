# HingeAuto — ⚠️ fill in at least one API key

# Anthropic (JUDGE_BACKEND=anthropic) — best quality
ANTHROPIC_API_KEY=***

# Gemini (JUDGE_BACKEND=gemini) — cheap, good quality
GEMINI_API_KEY=***

# DeepSeek (JUDGE_BACKEND=deepseek) — cheap vision backend
DEEPSEEK_API_KEY=***

# Discord webhook for session reports (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Mode selection (default in config.py)
ACTIVE_MODE=carlos

# Judge settings
JUDGE_BACKEND=gemini
# Gemini flash options: gemini-3.1-flash-lite (cheapest), gemini-3.5-flash,
# gemini-3.8-flash (most intelligent)
GEMINI_MODEL=gemini-3.8-flash
# DeepSeek vision model: deepseek-flash (deepseek-v4-pro has no vision)
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=false

# Session limits
MAX_LIKES_PER_SESSION=12
SESSION_LIKE_MIN=0

# Pickiness: like iff fit_score >= THIS, else skip. Raise = pickier, lower = more volume.
FIT_SCORE_MIN=50

# Run mode
DRY_RUN=false
DRY_RUN_MESSAGE=false

# Debug output directory — where error screenshots and liked/skipped
# profile frames land (defaults to ./debug). Relative paths resolve from
# the repo root; absolute paths are used as-is.
DEBUG_DIR=./debug

# ---------- Device ----------
# The shipped defaults are 720x1600. Set these if you're running a different
# phone or emulator. Every value in COORDS is a raw pixel on THIS screen, so
# a different size means recalibrating the whole table.
# SCREEN_WIDTH=720
# SCREEN_HEIGHT=1600

# The reference resolution the fixed offsets in vision.py were drawn against.
# This is NOT the device — leave it alone unless you re-author those offsets,
# because changing it rescales every one of them.
# REF_WIDTH=1080
# REF_HEIGHT=2424

# Coordinate table, as JSON. Merged key-by-key over the defaults in
# config.py, so list only the keys you want to move — everything you leave
# out keeps its shipped value. Get the numbers from `python calibrate.py`.
# COORDS='{"skip_button": [89, 1319]}'
